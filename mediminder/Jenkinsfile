pipeline {
    // Run on the Windows Jenkins master node directly
    agent any
    
    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Dependencies & Test') {
            steps {
                dir('mediminder') {
                    // Instead of volume mounting (which causes permission issues on Windows),
                    // we copy the code INTO the container, run the commands, then copy artifacts out.
                    bat '''
                    docker create --name mediminder-build -w /app mediminder:latest bash -c "flutter clean && flutter pub get && flutter test"
                    docker cp . mediminder-build:/app
                    docker start -a mediminder-build
                    docker rm mediminder-build
                    '''
                }
            }
        }
        
        stage('Build APK') {
            steps {
                dir('mediminder') {
                    bat '''
                    docker create --name mediminder-apk -w /app mediminder:latest bash -c "flutter build apk --release"
                    docker cp . mediminder-apk:/app
                    docker start -a mediminder-apk
                    docker cp mediminder-apk:/app/build/app/outputs/flutter-apk/app-release.apk app-release.apk
                    docker rm mediminder-apk
                    '''
                }
            }
            post {
                success {
                    archiveArtifacts artifacts: 'mediminder/app-release.apk', fingerprint: true
                }
            }
        }
    }
}
