pipeline {
    // Uses the Docker Pipeline plugin to spin up our build agent
    agent {
        docker { 
            image 'mediminder:latest'
            // Run as root to ensure we can write to the Jenkins workspace volume
            args '-u root'
            // If the process fails to find docker, ensure Docker Desktop is running and integrated
        }
    }
    
    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Dependencies & Test') {
            steps {
                dir('mediminder') {
                    sh 'flutter clean'
                    sh 'flutter pub get'
                    sh 'flutter test'
                }
            }
        }
        
        stage('Build APK') {
            steps {
                dir('mediminder') {
                    sh 'flutter build apk --release'
                }
            }
            post {
                success {
                    archiveArtifacts artifacts: 'mediminder/build/app/outputs/flutter-apk/app-release.apk', fingerprint: true
                }
            }
        }
    }
}
