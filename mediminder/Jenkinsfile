pipeline {
    // Run on the Windows Jenkins master node directly
    agent any
    
    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Dependencies & Test') {
            steps {
                // We use native Windows batch commands to invoke Docker manually.
                // This avoids the Jenkins Docker Plugin trying to use Windows paths inside a Linux container.
                dir('mediminder') {
                    bat '''
                    docker run --rm -v "%CD%:/app" -w /app mediminder:latest bash -c "flutter clean && flutter pub get && flutter test"
                    '''
                }
            }
        }
        
        stage('Build APK') {
            steps {
                dir('mediminder') {
                    bat '''
                    docker run --rm -v "%CD%:/app" -w /app mediminder:latest bash -c "flutter build apk --release"
                    '''
                }
            }
            post {
                success {
                    // Archive the built APK so it can be downloaded from Jenkins
                    archiveArtifacts artifacts: 'mediminder/build/app/outputs/flutter-apk/app-release.apk', fingerprint: true
                }
            }
        }
    }
}
